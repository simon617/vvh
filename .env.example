# =====================================================================
# vvh — environment configuration
#
# LOCAL DEV:   copy this file to .env and fill in real values
#              (cp .env.example .env — Windows: copy .env.example .env)
# PRODUCTION:  /opt/vvh/.env  on the server, owner deploy, chmod 600,
#              populated by the operator (never commit real secrets).
# =====================================================================

# ---- Database (SQLite via Prisma) ------------------------------------
# Relative to the app WORKDIR (/app) inside the container =>
# /app/prisma/data/vvh.db, persisted in the named volume vvh_sqlite-data.
DATABASE_URL="file:./data/vvh.db"

# ---- Authentication ---------------------------------------------------
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   or on the server:  openssl rand -hex 32
JWT_SECRET=""

# ---- SMTP (optional — contact form) ------------------------------------
SMTP_HOST=""
SMTP_PORT="25"
SMTP_RECIPIENT=""

# ---- Site --------------------------------------------------------------
# NEXT_PUBLIC_* values are INLINED BY NEXT.JS AT BUILD TIME. The CI/deploy
# workflows pass this via vars.NEXT_PUBLIC_SITE_URL; keep both in sync.
NEXT_PUBLIC_SITE_URL="https://www.visionvalues.com.hk"

# ---- Uploads -----------------------------------------------------------
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="5242880"

# ---- Deployment (server only) ------------------------------------------
# Set true ONLY if the runtime image ships the Prisma CLI (the default image
# does not). See DEPLOYMENT.md → Schema migrations. Default: false.
MIGRATE_ON_DEPLOY="false"